[Unit]
Description=Sistem Payroll & Slip Gaji WhatsApp
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/slip-gaji-app
ExecStart=%h/Documents/slip-gaji-app/start-payroll.sh
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=default.target

